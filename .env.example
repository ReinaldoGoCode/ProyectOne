# Número de WhatsApp de la tienda en formato internacional, sin + ni espacios.
# Si se deja vacío, la demo no abre WhatsApp: solo permite copiar el mensaje.
VITE_STORE_WHATSAPP_NUMBER=

# Public values only. When both are set, checkout uses the remote quote/order API;
# missing server functions produce an error instead of silently saving locally.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side secrets: set only in Supabase Edge Function secrets, never in VITE_*.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGIN=

# Meta WhatsApp webhook verification.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# At least 32 random characters each. Store as Edge Function secrets only.
WHATSAPP_PHONE_HASH_SECRET=
WHATSAPP_DISPATCH_SECRET=
# International business phone, digits only; used in secure product purchase links.
WHATSAPP_BUSINESS_PHONE=
# Public HTTPS site origin used to return the selected product link in the chat.
PUBLIC_SITE_URL=
# Keep sending disabled until the owner explicitly authorizes activation.
WHATSAPP_SEND_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
# Follow-up template: use only after this exact template is approved by Meta.
WHATSAPP_ORDER_TEMPLATE_APPROVED=false
WHATSAPP_ORDER_TEMPLATE_NAME=
WHATSAPP_ORDER_TEMPLATE_LANGUAGE=
# Optional Groq Free Plan intent classifier; keep disabled unless the account's
# dashboard confirms it is on the Free plan and no billing/payment method is active.
# Never set a VITE_* AI key. The API host is fixed in server code and never falls back.
WHATSAPP_AI_ENABLED=false
WHATSAPP_AI_FREE_TIER_CONFIRMED=false
WHATSAPP_AI_PRIVACY_CONTROLS_CONFIRMED=false
WHATSAPP_AI_PROVIDER=groq
WHATSAPP_AI_API_KEY=
WHATSAPP_AI_MODEL=openai/gpt-oss-20b
# Conservative server-side caps. They may be lowered but cannot exceed 8/min, 100/day.
WHATSAPP_AI_MAX_REQUESTS_PER_MINUTE=8
WHATSAPP_AI_MAX_REQUESTS_PER_DAY=100
WHATSAPP_AI_MAX_COMPLETION_TOKENS=128
WHATSAPP_AI_MAX_INPUT_CHARS=400
